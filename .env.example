# Copie este archivo a .env y complete los valores. En Azure App Service defina estas
# mismas variables en Configuración > Variables de entorno (idealmente como referencias
# a Azure Key Vault). Ver docs/DEPLOY-AZURE.md.

# ---------- Alma ----------
# Región de la API de Alma (Colombia usa Norteamérica)
ALMA_HOST=https://api-na.hosted.exlibrisgroup.com
ALMA_PATH=/almaws/v1
# API key del Ex Libris Developer Network, solo lectura: Bibs y Users
ALMA_API_KEY=
# Tiempo máximo de espera por petición a Alma (ms)
ALMA_TIMEOUT_MS=8000

# ---------- Servidor ----------
PORT=3000
TZ=America/Bogota
# "production" activa las validaciones de producción (Azure se detecta solo con WEBSITE_SITE_NAME)
NODE_ENV=
# Saltos de proxy de confianza. Vacío = automático: 1 en Azure App Service, false en otros entornos.
# No lo active en la red interna sin proxy: permitiría falsificar la IP con X-Forwarded-For.
TRUST_PROXY=

# ---------- Acceso ----------
# PIN de acceso (mínimo 8 caracteres). Obligatorio en producción.
ACCESS_PIN=
# Secreto para firmar la sesión (mínimo 32 caracteres; obligatorio si hay ACCESS_PIN). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
# true permite producción sin PIN. Úselo SOLO si el acceso ya está restringido por red
# (restricciones de acceso de App Service) o por Entra ID (App Service Authentication).
ALLOW_OPEN_ACCESS=false

# ---------- Pantalla ----------
# Identificación completa del usuario (true) o solo los últimos 4 dígitos (false)
SHOW_FULL_USER_ID=true
# Portadas desde Open Library / Google Books (true). false = sin peticiones a terceros.
SHOW_COVERS=true
# Días de gracia para préstamos vencidos. 0 = cualquier préstamo vencido requiere
# autorización de un representante de la biblioteca para salir.
OVERDUE_GRACE_DAYS=0

# ---------- Webhooks de Alma ----------
# Secreto para validar webhooks. Vacío = la ruta /webhooks no existe.
WEBHOOK_SECRET=
