# Copie este archivo a .env y complete los valores. En Azure App Service
# defina estas mismas variables en Configuración > Variables de entorno.

# Región de la API de Alma (Colombia usa Norteamérica)
ALMA_HOST=https://api-na.hosted.exlibrisgroup.com
ALMA_PATH=/almaws/v1
# API key del Ex Libris Developer Network (permiso de lectura: Bibs; opcional: Users)
ALMA_API_KEY=
# Tiempo máximo de espera por petición a Alma (ms)
ALMA_TIMEOUT_MS=8000

# Secreto para validar webhooks de Alma (vacío = webhooks deshabilitados)
WEBHOOK_SECRET=

PORT=3000
TZ=America/Bogota

# Si se define, la pantalla pide este PIN antes de consultar (recomendado en Azure)
ACCESS_PIN=
# Secreto para firmar la cookie de acceso (obligatorio si ACCESS_PIN está definido)
COOKIE_SECRET=

# Mostrar la identificación completa del usuario (true) o solo los últimos 4 dígitos (false)
SHOW_FULL_USER_ID=true

# Días de gracia para préstamos vencidos. 0 = cualquier préstamo vencido requiere
# autorización de un representante de la biblioteca para salir.
OVERDUE_GRACE_DAYS=0
